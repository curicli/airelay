# airelay keys go here, never in config.json.
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# Then start with ./start.sh, which loads this file automatically.
# Write "${BACKUP_RELAY_KEY}" in config.json and it is substituted at runtime.

# Key for your second relay
BACKUP_RELAY_KEY=

# Direct-to-Anthropic backstop (fill it in if you have one; interruptions become
# almost impossible with a second, independent path)
ANTHROPIC_API_KEY=
